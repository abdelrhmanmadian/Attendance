# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL via Prisma) ---
# For local dev with the provided docker-compose.yml (`docker compose up -d`),
# this matches its POSTGRES_USER/PASSWORD/DB. In production (e.g. Render),
# use the connection string your database provider gives you instead.
DATABASE_URL="postgresql://attendance:attendance@localhost:5432/attendance"

# --- Sessions ---
# Long random string used to sign the manager session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Seeded manager accounts (used only by `npm run prisma:seed`) ---
MANAGER1_EMAIL=manager1@example.com
MANAGER1_TEMP_PASSWORD=ChangeMe123!
MANAGER2_EMAIL=manager2@example.com
MANAGER2_TEMP_PASSWORD=ChangeMe123!

# --- Google Sheets sync (optional for local development) ---
# Leave these unset to run the app with Sheets sync disabled: attendance rows
# are still written to the database and simply marked syncedToSheet=false.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
